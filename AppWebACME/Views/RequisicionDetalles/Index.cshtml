@model IEnumerable<AppWebACME.Models.RequisicionDetalle>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Linea)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cantidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Activo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdarticuloNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdrequisicionNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Linea)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cantidad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Activo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdarticuloNavigation.Idarticulo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdrequisicionNavigation.Idrequisicion)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdrequisicionDetalle">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdrequisicionDetalle">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdrequisicionDetalle">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
